---
interface Project {
  title: string;
  description: string;
  technologies: string[];
  keywords?: string;
  link?: string;
}

interface Props {
  projects?: Project[];
}

// Mapping des technologies vers leurs icônes
const techEmojis: Record<string, string> = {
};

const {
  projects = [
    {
      title: "Timed Automate GUI",
      description: "Design and implementation of a graphical user interface for a search tool.",
      technologies: ["Python", "PySide6", "Git", "GitHub"],
      link:"https://github.com/metuscarnel/timed-automata-gui",
      keywords:"timed automata, dbm, model checking, gui"
    },
    {
      title: "TSP Résolution",
      description: "Résolution du Problème du Voyageur de Commerce par Algorithme Génétique",
      technologies: ["Python", "Git", "GitHub", "Plotly"],
      link: "https://github.com/metuscarnel/tsp-project",
      keywords:"tsp (travelling salesman problem), algo génétique, analyse combinatoire"
    },
    {
      title: "MaxPar : Parallélisation maximale automatique",
      description: "Développement d'une bibliothèque en Python pour automatiser la parallélisation maximale de systèmes de tâches",
      technologies: ["Python", "Git", "GitHub", "Graphviz"],
      link: "https://github.com/metuscarnel/maxpar/tree/metus_version",
      keywords:"parallélisation, tâches, graphes de dépendances, conditions de Bernstein",
    },
    {
      title: "Connect4",
      description:
        "Développement d'un jeu de Puissance 4 en Python avec une grille personnalisée de 8x9. Implémentation de l'algorithme Minimax pour une IA compétitive.",
      technologies: ["Python", "JSON", "Git" , "GitHub", "MySQL"],
      link: "https://github.com/connectFourSite",
      keywords:"minimax, kanban, gestion de projet"
    },
    {
      title: "Plateforme de gestion hotelière",
      description:
        "Développement d'une application web complète pour la gestion hôtelière, incluant la réservation de chambres, la gestion des clients et la facturation.",
      technologies: ["Java", "Swing", "FlatLaf", "SQLite"],
      link: "https://github.com",
      keywords:"mvc, uml"
    },
    {
      title: "Conception du système de gestion d'un réseaux de transport",
      description:
        "Analyse Fonctionnelle et Conception du nouveau Système de la Société TRICE. Projet académique de Modélisation Objet UML.",
      technologies: ["LaTeX", "UML", "Git", "GitHub", "Figma"],
      link: "https://github.com",
      keywords:"analyse fonctionnelle, conception, uml"
    },
  ],
} = Astro.props;
---

<section id="projects" class="projects section-animate" aria-labelledby="projects-heading">
  <div class="projects-container">
    <h2 id="projects-heading" class="section-title">Projets</h2>
    <div class="projects-list">
      {
        projects.map((project, index) => (
          <article class="project-item">
            <div class="project-header">
              <span class="project-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="project-title">
                {project.link ? (
                  <a
                    href={project.link}
                    class="project-link link-hover"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.title}
                    <span class="sr-only">(ouvre dans un nouvel onglet)</span>
                  </a>
                ) : (
                  project.title
                )}
              </h3>
            </div>
            <p class="project-description">{project.description}</p>
            <div class="project-footer">
              <ul class="project-tech" role="list">
                {project.technologies.map((tech) => (
                  <li class="tech-item">
                    <span class="tech-name">{tech}</span>
                  </li>
                ))}
              </ul>
              {project.keywords && <div class="project-keywords"><span class="keywords-label">Mots clés :</span> {project.keywords}</div>}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    padding: var(--spacing-2xl) var(--spacing-xl);
    background-color: var(--bg-secondary);
    transition: background-color 0.3s ease;
  }

  .projects-container {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .section-title {
    font-family: var(--font-family);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-xl);
    transition: color 0.3s ease;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
  }

  .project-item {
    padding-bottom: var(--spacing-2xl);
    border-bottom: 1px solid var(--border-color);
    transition: border-color 0.3s ease;
  }

  .project-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-header {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
  }

  .project-number {
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s ease;
  }

  .project-title {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .project-link {
    color: var(--text-primary);
    transition: color 0.3s ease;
  }

  .project-description {
    font-size: var(--font-size-base);
    color: var(--text-primary);
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
    margin-left: calc(var(--spacing-md) + 1.5rem);
    transition: color 0.3s ease;
  }

  .project-footer {
    margin-left: calc(var(--spacing-md) + 1.5rem);
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    align-items: center;
  }

  .tech-item {
    display: inline;
    transition: all 0.3s ease;
  }

  .tech-item::after {
    content: ", ";
    color: var(--text-secondary);
  }

  .tech-item:last-child::after {
    content: "";
  }

  .tech-name {
    font-family: var(--font-family);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }

  .tech-item:hover .tech-name {
    color: var(--text-secondary);
  }

  /* Light theme adjustments */
  :global([data-theme="light"]) .tech-item:hover .tech-name {
    color: var(--text-tertiary);
  }

  .tech-emoji {
    display: none;
  }

  .tech-name {
    font-family: var(--font-family-heading);
    font-size: var(--font-size-sm);
    font-weight: 500;
    font-style: italic;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }

  .tech-item:hover .tech-name {
    color: var(--text-secondary);
  }

  /* Light theme adjustments */
  :global([data-theme="light"]) .tech-item:hover .tech-name {
    color: var(--text-tertiary);
  }

  .project-keywords {
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    margin-top: var(--spacing-sm);
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .keywords-label {
    font-weight: 600;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .projects {
      padding: var(--spacing-3xl) var(--spacing-lg);
    }

    .project-description,
    .project-tech {
      margin-left: 0;
    }

    .project-header {
      flex-direction: column;
      gap: var(--spacing-xs);
    }
  }
</style>
